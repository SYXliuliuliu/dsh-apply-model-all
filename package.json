{
  "name": "dsh-apply-model-all",
  "version": "0.1.0",
  "description": "Apply the current session's model to every session in one click: a compact control next to the composer's model picker that writes the active provider/model into the per-session model selection of every session that can hold one.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "sessions"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "SYXliuliuliu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYXliuliuliu/dsh-apply-model-all.git"
  },
  "bugs": {
    "url": "https://github.com/SYXliuliuliu/dsh-apply-model-all/issues"
  },
  "homepage": "https://github.com/SYXliuliuliu/dsh-apply-model-all#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-session-controller": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
